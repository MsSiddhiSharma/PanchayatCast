# ==============================================================================
# SIH26074 - PanchayatCast Environment Variables Configuration
# Copy this file to .env and fill in your local or test credentials.
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT REPOSITORY.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL + PostGIS Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=panchayat_user
DB_PASSWORD=panchayat_password_change_me
DB_NAME=panchayatcast_db
DATABASE_URL=postgresql://panchayat_user:panchayat_password_change_me@localhost:5432/panchayatcast_db

# External Weather Data Source API Keys (Leave blank or insert sandbox keys)
IMD_API_KEY=
IMD_API_BASE_URL=https://mausam.imd.gov.in/api/v1
COPERNICUS_CDS_URL=https://cds.climate.copernicus.eu/api/v2
COPERNICUS_CDS_KEY=
BHUVAN_API_KEY=

# ML Model Registry and Storage
MODEL_REGISTRY_PATH=ml/model_registry/registry.json
ACTIVE_MODEL_NAME=xgboost
ACTIVE_MODEL_VERSION=v1

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_DEFAULT_LAT=20.5937
NEXT_PUBLIC_DEFAULT_LON=78.9629
NEXT_PUBLIC_DEFAULT_ZOOM=6
